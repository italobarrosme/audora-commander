#!/usr/bin/env bash
# Hook PostToolUse (Edit|Write): integridade do GRAFO v2.
# Acusa: nó ativo sem arquivo (e sem corpo inline legado), arquivo sem linha
# no índice, depende-de inexistente, ciclo. Erro → exit 2 + stderr.
# Contrato: falha do hook NUNCA quebra o fluxo — na dúvida, exit 0.
set -uo pipefail

input="$(cat)"
file_path="$(printf '%s' "$input" | perl -MJSON::PP -0777 -ne '
  my $d = eval { decode_json($_) } or exit 0;
  print $d->{tool_input}{file_path} // "";' 2>/dev/null)" || exit 0
[ -n "$file_path" ] || exit 0
file_path="${file_path//\\//}"

case "$file_path" in
  *GRAFO.md) root="$(dirname "$file_path")" ;;
  *docs/audora/nos/*.md)
    root="${file_path%docs/audora/nos/*}"; root="${root%/}"
    [ -n "$root" ] || root="." ;;
  *) exit 0 ;;
esac
grafo="$root/GRAFO.md"
[ -f "$grafo" ] || exit 0
# GRAFO.md lido sempre sem \r (projetos com CRLF)
corpo="$(tr -d '\r' < "$grafo")"
printf '%s\n' "$corpo" | head -1 | grep -q 'versao-schema: 2' || exit 0
nos_dir="$root/docs/audora/nos"

erros=""
idx="$(printf '%s\n' "$corpo" | sed -n '/^## Índice de nós/,/^## [^Í]/p' | grep '^- ' || true)"
idx_ids="$(printf '%s\n' "$idx" | sed 's/^- *\([^ |]*\).*/\1/')"
inline_ids="$(printf '%s\n' "$corpo" | grep '^### ' | sed 's/^### *//' || true)"

# 1. estado fora do enum EN (migração PT→EN pendente), linha sem estado,
#    e nó ativo sem corpo (arquivo ou inline legado)
while IFS= read -r linha; do
  [ -n "$linha" ] || continue
  id="$(printf '%s' "$linha" | sed 's/^- *\([^ |]*\).*/\1/')"
  estado="$(printf '%s' "$linha" | awk -F'|' 'NF>1 {gsub(/ /,"",$2); print $2}')"
  if [ -z "$estado" ]; then
    erros="$erros
- linha do índice sem coluna de estado: '$linha' — formato é \`- <id> | <estado> | <título> | <resumo> | <keywords> | <arquivos>\` (templates/GRAFO-template.md)"
    continue
  fi
  case "$estado" in
    planned|in-progress|blocked|delivered|discarded|hotfix-pending-record) ;;
    *) erros="$erros
- nó '$id' com estado '$estado' fora do enum (planned|in-progress|blocked|delivered|discarded|hotfix-pending-record) — migração PT→EN pendente: skill graph converte TODOS os estados na primeira escrita (tabela em templates/no-template.md)" ;;
  esac
  case "$estado" in
    in-progress|blocked)
      if [ ! -f "$nos_dir/$id.md" ] && ! printf '%s\n' "$inline_ids" | grep -qx "$id"; then
        erros="$erros
- nó '$id' ($estado) sem arquivo docs/audora/nos/$id.md e sem corpo inline"
      fi ;;
  esac
done <<EOF_IDX
$idx
EOF_IDX

# 2. arquivo de nó sem linha no índice
if [ -d "$nos_dir" ]; then
  for f in "$nos_dir"/*.md; do
    [ -e "$f" ] || continue
    b="$(basename "$f" .md)"
    case "$b" in *-historico) continue ;; esac
    printf '%s\n' "$idx_ids" | grep -qx "$b" || erros="$erros
- arquivo docs/audora/nos/$b.md sem linha no índice mestre"
  done
fi

# 3. deps inexistentes + coleta de arestas (arquivos E nós inline legados)
edges=""
coletar() { # $1 = id, $2 = lista de deps separada por espaço
  local b="$1" d
  for d in $2; do
    [ -n "$d" ] || continue
    case "$d" in *:*) continue ;; esac
    printf '%s\n' "$idx_ids" | grep -qx "$d" || erros="$erros
- nó '$b' depende de '$d', que não existe no índice"
    edges="$edges$b $d
"
  done
}
if [ -d "$nos_dir" ]; then
  for f in "$nos_dir"/*.md; do
    [ -e "$f" ] || continue
    b="$(basename "$f" .md)"
    case "$b" in *-historico) continue ;; esac
    coletar "$b" "$(grep -m1 '^depende-de:' "$f" | tr -d '\r' | sed 's/^depende-de: *\[\(.*\)\].*/\1/' | tr ',' ' ')"
  done
fi
for b in $inline_ids; do
  [ -f "$nos_dir/$b.md" ] && continue
  coletar "$b" "$(printf '%s\n' "$corpo" | sed -n "/^### $b\$/,/^### /p" | grep -m1 'depende-de' | sed 's/.*\[\(.*\)\].*/\1/' | tr ',' ' ')"
done

# 4. ciclo (awk DFS; portável gawk/mawk/busybox)
if [ -n "$edges" ]; then
  ciclo="$(printf '%s' "$edges" | awk '
    { adj[$1] = adj[$1] " " $2; nodes[$1]=1; nodes[$2]=1 }
    function dfs(u,  m,i,arr) {
      if (stk[u]) return 1
      if (vis[u]) return 0
      vis[u]=1; stk[u]=1
      m=split(adj[u], arr, " ")
      for (i=1;i<=m;i++) if (arr[i]!="" && dfs(arr[i])) return 1
      stk[u]=0; return 0
    }
    END { for (n in nodes) { delete vis; delete stk; if (dfs(n)) { print n; exit } } }')"
  [ -n "$ciclo" ] && erros="$erros
- ciclo em depende-de alcançável a partir de '$ciclo' (siga as arestas dele)"
fi

if [ -n "$erros" ]; then
  echo "grafo-validate: memória inconsistente — PARE e corrija antes de seguir:$erros" >&2
  exit 2
fi
exit 0
