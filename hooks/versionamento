#!/usr/bin/env bash
# Script auxiliar da skill memory (chamado via Bash pela skill; NÃO é hook do harness).
# Uso: versionamento checar | aplicar [--desligar <arquivo>:<linha>]... [--remover]
# Sempre na raiz do projeto (cwd). checar só lê; aplicar escreve o bloco do audora
# no .gitignore (sem duplicar).
# Contrato completo: nó gitignore-padrao / skills/memory/references/versionamento.md.
set -uo pipefail
here="${0//\\//}"
VERS_DIR="$(cd "$(dirname "$here")" && pwd)" || exit 1
export VERS_DIR
exec perl -x "$VERS_DIR/$(basename "$here")" "$@"

#!perl
use strict;
use warnings;

my $USO = 'uso: versionamento checar | aplicar [--desligar <arquivo>:<linha>]... [--remover]';
my $FORA = 'versionamento: fora do git — checagem de regra e remoção puladas';
my @BLOCO = (
  '# audora-commander: specs, planos, e2e e depuracao ficam so no disco',
  'docs/audora/specs/',
  'docs/audora/planos/',
  'docs/audora/e2e/',
  'docs/audora/depuracao/',
  '# fim audora-commander',
);

sub sai { my ($code, @linhas) = @_; print "$_\n" for @linhas; exit $code; }

# ler <caminho> → conteúdo bruto (undef se não existir)
sub ler {
  my ($f) = @_;
  open my $fh, '<:raw', $f or return undef;
  local $/; my $c = <$fh>; close $fh; return $c // '';
}
sub escreve {
  my ($f, $c) = @_;
  open my $fh, '>:raw', $f or die "não consegui escrever $f\n";
  print $fh $c; close $fh or die "não consegui escrever $f\n";
}

my $sub = shift @ARGV // '';
sai(1, $USO) unless $sub =~ /^(checar|aplicar)$/;

sub dentro_git { my $r = `git rev-parse --is-inside-work-tree 2>/dev/null`; return ($r // '') =~ /true/; }

# Bloco presente = alguma linha igual à 1ª linha do bloco (ignorando \r).
sub bloco_presente {
  my ($c) = @_;
  return 0 unless defined $c;
  for (split /\n/, $c) { s/\r$//; return 1 if $_ eq $BLOCO[0]; }
  return 0;
}

# Escreve o bloco no .gitignore da raiz → mensagem do que fez.
sub escreve_bloco {
  my $c = ler('.gitignore');
  return 'versionamento: bloco do audora já presente — .gitignore intocado' if bloco_presente($c);
  unless (defined $c) {
    escreve('.gitignore', join('', map { "$_\n" } @BLOCO));
    return 'versionamento: .gitignore criado com o bloco do audora';
  }
  my $nl = $c =~ /\r\n/ ? "\r\n" : "\n";
  my $novo = $c;
  $novo .= $nl if length $novo && $novo !~ /\n\z/;
  $novo .= $nl if length $novo;
  $novo .= join('', map { "$_$nl" } @BLOCO);
  escreve('.gitignore', $novo);
  return 'versionamento: bloco do audora acrescentado ao .gitignore';
}

# --- leitura do git ---
sub git_z {
  local $/ = "\0";
  open my $fh, '-|', 'git', '--no-optional-locks', @_ or die "git @_ falhou\n";
  my @r = <$fh>; close $fh; chomp @r; return @r;
}

# Memória versionada sondada: rótulo → caminho testado.
my @MEMORIA = (
  ['MEMORY.md', 'MEMORY.md'], ['PRD.md', 'PRD.md'], ['CHANGELOG.md', 'CHANGELOG.md'],
  ['docs/audora/memory/', 'docs/audora/memory/x.md'], ['docs/audora/arquivo/', 'docs/audora/arquivo/x.md'],
  ['docs/audora/decisoes-vivas.md', 'docs/audora/decisoes-vivas.md'], ['docs/audora/aprendizados.md', 'docs/audora/aprendizados.md'],
);
my @EFEMERAS = ('docs/audora/specs', 'docs/audora/planos', 'docs/audora/e2e', 'docs/audora/depuracao');

# Fonte editável = um .gitignore dentro do projeto (caminho relativo, fora de .git/).
sub fonte_do_projeto {
  my ($f) = @_;
  return 0 if $f =~ m{^/} || $f =~ m{^[A-Za-z]:} || $f =~ m{^\.\.(/|$)} || $f =~ m{^\.git/};
  return $f =~ m{(^|/)\.gitignore$} ? 1 : 0;
}

# Regras que escondem a memória: lista de [rótulo, fonte, linha, padrão]. Negação (!) não esconde.
use File::Temp ();
sub regras_memoria {
  my $in = File::Temp->new(); binmode $in; print $in map { "$_->[1]\0" } @MEMORIA; close $in;
  open my $velho, '<&', \*STDIN or die "stdin\n";
  open STDIN, '<', $in->filename or die "stdin\n";
  # -n: toda entrada sai (campos vazios sem regra) → 4 campos por caminho, na ordem de @MEMORIA.
  my @c = git_z('check-ignore', '-v', '-n', '-z', '--stdin', '--no-index');
  open STDIN, '<&', $velho or die "stdin\n";
  my @r;
  for my $i (0 .. $#MEMORIA) {
    my ($fonte, $linha, $padrao) = @c[4 * $i .. 4 * $i + 2];
    next if !defined $fonte || $fonte eq '' || $padrao =~ /^!/;
    push @r, [$MEMORIA[$i][0], $fonte, $linha, $padrao];
  }
  return @r;
}

sub efemeros_versionados { git_z('ls-files', '-z', '--', @EFEMERAS); }

sub checar {
  my @o = ('bloco: ' . (bloco_presente(ler('.gitignore')) ? 'presente' : 'ausente'));
  sai(0, @o, $FORA) unless dentro_git();
  my @regras = regras_memoria();
  for my $r (@regras) {
    my ($rot, $fonte, $linha, $padrao) = @$r;
    my $suf = fonte_do_projeto($fonte) ? "ajuste: aplicar --desligar $fonte:$linha" : 'fonte fora do projeto — não edito';
    push @o, "memória ignorada: $rot | regra $fonte:$linha $padrao | $suf";
  }
  push @o, 'quebra: arquivamento do nó, comando de arquivos do cartão e cleanup' if @regras;
  my @v = efemeros_versionados();
  push @o, map { "versionado em pasta efêmera: $_" } @v;
  push @o, 'versionamento: ' . scalar(@regras) . ' regra(s) escondendo a memória · ' . scalar(@v) . ' versionado(s) em pasta efêmera';
  sai(0, @o);
}

checar() if $sub eq 'checar';

# Linhas de um arquivo com o fim de linha de cada uma: [conteúdo, fim].
sub linhas { map { /^(.*?)(\r?\n)?\z/s; [$1, $2 // ''] } split /(?<=\n)/, ($_[0] // ''); }

# Por que --desligar <arquivo>:<linha> não pode ser aplicado (undef = pode).
sub valida_desligar {
  my ($f, $n) = @_;
  return "versionamento: $f fica fora do projeto — não edito; nada foi alterado" unless fonte_do_projeto($f);
  my @l = linhas(ler($f));
  my $s = ($n >= 1 && $n <= @l) ? $l[$n - 1][0] : '';
  return "versionamento: $f:$n não é regra ativa — nada foi alterado" if $s =~ /^\s*(#|$)/;
  return undef;
}

# Comenta a linha <n> de <f>, preservando o fim de linha → mensagem.
sub desliga {
  my ($f, $n) = @_;
  my @l = linhas(ler($f));
  my $orig = $l[$n - 1][0];
  $l[$n - 1][0] = "# desligado pelo audora-commander: $orig";
  escreve($f, join '', map { $_->[0] . $_->[1] } @l);
  return "versionamento: regra desligada em $f:$n ($orig)";
}

if ($sub eq 'aplicar') {
  my @desligar;
  while (@ARGV) {
    my $a = shift @ARGV;
    sai(1, $USO) unless $a eq '--desligar' && @ARGV && $ARGV[0] =~ /^(.+):(\d+)$/;
    push @desligar, [$1, $2 + 0]; shift @ARGV;
  }
  my $git = dentro_git();
  for my $d (@desligar) { my $m = valida_desligar(@$d); sai(1, $m) if defined $m; }
  my @o = map { desliga(@$_) } @desligar;
  push @o, escreve_bloco();
  sai(0, @o, $git ? () : $FORA);
}
sai(1, $USO);
