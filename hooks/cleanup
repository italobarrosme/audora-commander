#!/usr/bin/env bash
# Script auxiliar da skill cleanup (chamado via Bash pela skill; NÃO é hook do harness).
# Uso: cleanup varrer [--orfao <id>=<motivo>]... | contar | aplicar <lote>
# Sempre na raiz do projeto (cwd). varrer/contar só leem; aplicar aplica o lote
# aprovado num commit só e desfaz tudo se algo falhar.
# Contrato completo: docs do nó skill-cleanup / skills/cleanup/SKILL.md.
set -uo pipefail
here="${0//\\//}"
CLEANUP_DIR="$(cd "$(dirname "$here")" && pwd)" || exit 1
export CLEANUP_DIR
exec perl -x "$CLEANUP_DIR/$(basename "$here")" "$@"

#!perl
use strict;
use warnings;

my $USO = 'uso: cleanup varrer [--orfao <id>=<motivo>]... | contar | aplicar <lote>';

sub sai { my ($code, @linhas) = @_; print "$_\n" for @linhas; exit $code; }

my $sub = shift @ARGV // '';
sai(1, $USO) unless $sub =~ /^(varrer|contar|aplicar)$/;

# varrer: --orfao <id>=<motivo> (repetível) — julgamento semântico da skill (/3, /4)
my %ORFAO_ARG;
if ($sub eq 'varrer') {
  while (@ARGV) {
    my $a = shift @ARGV;
    sai(1, $USO) unless $a eq '--orfao' && @ARGV && $ARGV[0] =~ /^([^=\s]+)=(.+)$/s;
    $ORFAO_ARG{$1} = $2; shift @ARGV;
  }
}

# --- pré-condições comuns: repo git e MEMORY.md na raiz ---
{
  my $dentro = `git rev-parse --is-inside-work-tree 2>/dev/null`;
  sai(1, 'cleanup: não é repositório git — nada foi alterado') unless ($dentro // '') =~ /true/;
}
sai(1, 'cleanup: sem MEMORY.md — rode o bootstrap da skill memory; nada foi alterado') unless -f 'MEMORY.md';

use File::Find ();

# Seções acionáveis do relatório, na ordem do contrato.
my @SECOES = ('planned órfão', 'spec de nó entregue', 'plano arquivado', 'relatório e2e',
              'depuração velha', 'sem referência', 'link quebrado');
my %VIVO = map { $_ => 1 } qw(planned in-progress blocked hotfix-pending-record);

# ler <caminho> → conteúdo bruto ('' se não existir)
sub ler {
  my ($f) = @_;
  open my $fh, '<:raw', $f or return '';
  local $/; my $c = <$fh>; close $fh; return $c // '';
}

# Índice de nós do MEMORY.md: lista de { id, estado, cols, n (linha 1-based) }.
my (@INDICE, %ESTADO, $TXT_INDICE);
sub carrega_indice {
  my @l = split /\n/, ler('MEMORY.md'), -1;
  my $dentro = 0; $TXT_INDICE = '';
  for my $i (0 .. $#l) {
    (my $s = $l[$i]) =~ s/\r$//;
    if ($s =~ /^## /) { $dentro = ($s =~ /^## Índice de nós/) ? 1 : 0; next; }
    next unless $dentro;
    $TXT_INDICE .= "$s\n";
    next unless $s =~ /^- *([^ |]+) *\|/;
    my @cols = map { s/^\s+|\s+$//gr } split /\|/, substr($s, 2);
    my $e = { id => $cols[0], estado => ($cols[1] // ''), cols => \@cols, n => $i + 1 };
    push @INDICE, $e; $ESTADO{$e->{id}} //= $e->{estado};
  }
}

# Todos os arquivos de docs/audora (no disco, rastreados ou não), relativos à raiz.
sub arquivos_docs {
  my @a;
  return @a unless -d 'docs/audora';
  File::Find::find({ no_chdir => 1, wanted => sub { push @a, $File::Find::name if -f $_ } }, 'docs/audora');
  return sort @a;
}

# Texto dos nós não arquivados (docs/audora/memory/*.md).
sub texto_nos { join "\n", map { ler($_) } sort { $a cmp $b } glob('docs/audora/memory/*.md'); }

my (%LOTE, @AVISOS, @MANTIDO, @NAO_TOCADO, @NUNCA);
# Item único por (tipo, alvo, motivo): o mesmo link quebrado 2x na linha é 1 item (o aplicar troca os dois).
my %ITEM_VISTO;
sub item {
  my ($sec, $alvo, $motivo) = @_;
  push @{ $LOTE{$sec} }, [$alvo, $motivo] unless $ITEM_VISTO{"$sec\0$alvo\0$motivo"}++;
}
# Link para caminho nunca versionado: aviso fora do lote (nunca trocado).
sub nunca {
  my ($alvo, $raw) = @_;
  push @NUNCA, "- $alvo | aponta $raw nunca versionado" unless $ITEM_VISTO{"nunca\0$alvo\0$raw"}++;
}

# depende-de dos nós não arquivados: id → [dependentes]
sub dependentes {
  my %d;
  for my $f (sort { $a cmp $b } glob('docs/audora/memory/*.md')) {
    (my $b = $f) =~ s{.*/|\.md$}{}g;
    my ($lista) = ler($f) =~ /^depende-de:[ \t]*\[([^\]\r\n]*)\]/m or next;
    for my $id (map { s/^\s+|\s+$//gr } split /,/, $lista) { push @{ $d{$id} }, $b if length $id; }
  }
  return %d;
}

# Repositório com ao menos 1 commit (sem HEAD, nada existiu); calcula uma vez por execução.
my $TEM_HEAD;
sub tem_head {
  unless (defined $TEM_HEAD) { `git rev-parse -q --verify HEAD 2>/dev/null`; $TEM_HEAD = $? == 0 ? 1 : ''; }
  return $TEM_HEAD;
}

# Caminho já versionado em commit alcançável do HEAD (pasta: algum arquivo sob ela).
sub existiu {
  return '' if $_[0] =~ m{^\.\.(/|$)};   # acima da raiz: fora do repo, nunca versionado aqui
  return '' unless tem_head();
  return scalar git_z('--literal-pathspecs', 'log', '-1', '--full-history', '--format=%H', 'HEAD', '--', $_[0]) ? 1 : '';
}

# Planned órfão: --orfao (semântico, prevalece) ou coluna arquivos-chave com alvo ausente.
sub classifica_orfaos {
  my %dep = dependentes();
  my %planned = map { $_->{id} => 1 } grep { $_->{estado} eq 'planned' } @INDICE;
  for my $id (sort { $a cmp $b } keys %ORFAO_ARG) {
    push @AVISOS, "aviso: --orfao $id ignorado — não é planned no índice" unless $planned{$id};
  }
  my %visto;
  for my $e (grep { $_->{estado} eq 'planned' } @INDICE) {
    my $id = $e->{id};
    next if $visto{$id}++;
    my $motivo = $ORFAO_ARG{$id};
    unless (defined $motivo) {
      my @aus = grep { $_ ne '' && $_ ne '—' && !/[*<]/ && !-e $_ && existiu($_) }
                map { s/^\s+|\s+$//gr } split /,/, ($e->{cols}[5] // '');
      $motivo = 'alvo ausente: ' . join(', ', @aus) if @aus;
    }
    next unless defined $motivo;
    if ($dep{$id}) { push @MANTIDO, "- $id | mantido: " . join(', ', @{ $dep{$id} }) . ' depende dele'; next; }
    item('planned órfão', $id, $motivo);
  }
}

# Arquivos .md de uma pasta, recursivo.
sub mds_em {
  my ($d) = @_; my @a;
  return @a unless -d $d;
  File::Find::find({ no_chdir => 1, wanted => sub { push @a, $File::Find::name if -f $_ && /\.md$/ } }, $d);
  return sort { $a cmp $b } @a;
}

# Documentos vivos (/8): índice, nós não arquivados, decisões vivas, aprendizados, PRD, READMEs, skills.
sub texto_vivo {
  my @f = ('MEMORY.md', 'docs/audora/decisoes-vivas.md', 'docs/audora/aprendizados.md', 'PRD.md',
           glob('README*.md'), glob('docs/audora/memory/*.md'), mds_em('skills'), mds_em('.claude/skills'));
  return join "\n", map { ler($_) } @f;
}

# Ligação por nome a um nó: (tipo, id) ou ().
sub ligacao {
  my ($f) = @_;
  return ('spec de nó entregue', $1) if $f =~ m{^docs/audora/specs/(.+)-escopo\.md$};
  return ('plano arquivado', $1)     if $f =~ m{^docs/audora/planos/arquivo/plano-(.+)\.md$};
  return ('', $1)                    if $f =~ m{^docs/audora/planos/plano-(.+)\.md$};
  return ('relatório e2e', $1)       if $f =~ m{^docs/audora/e2e/e2e-(.+)\.md$};
  return ();
}

# Fora de candidato: arquivo que o framework lê — nós (vivos e arquivados), decisões vivas e aprendizados.
sub protegido { $_[0] =~ m{^docs/audora/(memory|arquivo)/} || $_[0] =~ m{^docs/audora/(decisoes-vivas|aprendizados)\.md$} }

# Critérios <id>/<n> citados em $f e sem linha "- **<id>/<n>**" no nó arquivado
# (+ irmão -historico): menção em ponteiro não é cópia. Sem repetição, em ordem
# numérica. Nó arquivado = caminho após "→" no índice; sem seta (ou alvo
# ausente), o 1º docs/audora/arquivo/AAAA-MM-DD-<id>.md.
sub criterios_sem_copia {
  my ($f, $id) = @_;
  my $tok = qr{(?<![A-Za-z0-9_-])\Q$id\E/(\d+)(?!\d)};
  my $art = ler($f);
  my %cita; $cita{$1 + 0} = 1 while $art =~ /$tok/g;
  return () unless %cita;
  my ($e) = grep { $_->{id} eq $id } @INDICE;
  my ($no) = (($e->{cols}[2] // '') =~ /→\s*(\S+)/);
  unless (defined $no && -f $no) {
    ($no) = grep { m{/\d{4}-\d{2}-\d{2}-\Q$id\E\.md$} } sort glob('docs/audora/arquivo/*.md');
  }
  my $txt = defined $no ? ler($no) . "\n" . ler($no =~ s/\.md$/-historico.md/r) : '';
  my %tem; $tem{$1 + 0} = 1 while $txt =~ /^- \*\*\Q$id\E\/(\d+)(?!\d)/mg;
  return map { "$id/$_" } sort { $a <=> $b } grep { !$tem{$_} } keys %cita;
}

# Artefatos de nó entregue, depuração velha e sem referência.
sub classifica_artefatos {
  my $nos = texto_nos(); my $vivo = texto_vivo();
  for my $f (arquivos_docs()) {
    next if protegido($f);
    my ($tipo, $id) = ligacao($f);
    my $e = defined $id ? ($ESTADO{$id} // '') : '';
    if ($tipo && $e eq 'delivered') {
      my @sem = criterios_sem_copia($f, $id);
      if (@sem) { push @MANTIDO, "- $f | mantido: cita " . join(', ', @sem) . ' sem cópia no nó arquivado'; next; }
      item($tipo, $f, "nó $id delivered"); next;
    }
    next if $VIVO{$e};
    (my $b = $f) =~ s{.*/}{};
    if ($f =~ m{^docs/audora/depuracao/}) {
      next if index($TXT_INDICE, $b) >= 0 || index($nos, $b) >= 0;
      item('depuração velha', $f, 'sem nó vivo ligado'); next;
    }
    item('sem referência', $f, 'nenhum documento vivo o cita') if index($vivo, $b) < 0;
  }
}

# --- links: "[texto](alvo)" local e token docs/audora/…\.md fora de "](…)" ---
sub normaliza {
  my @p;
  for (split m{/+}, $_[0]) {
    next if $_ eq '.' || $_ eq '';
    if ($_ eq '..') { (@p && $p[-1] ne '..') ? pop @p : push @p, '..'; } else { push @p, $_; }
  }
  return join '/', @p;
}
sub pasta_de { (my $d = $_[0]) =~ s{/?[^/]*$}{}; return $d; }

# Token docs/audora/…\.md num trecho sem link markdown; a nota da cleanup não é link.
sub tokens {
  my ($s, $cb) = @_;
  $s =~ s{(`?)(?<![A-Za-z0-9._/-])(docs/audora/[A-Za-z0-9._/-]+\.md)(?![A-Za-z0-9._/-])(?!` (?:removido|já não existia) em)(`?)}{
    my ($a, $t, $z) = ($1, $2, $3);
    my $r = $cb->($t, normaliza($t));
    !defined $r ? "$a$t$z" : ($a && $z) ? $r : "$a$r$z";
  }ge;
  return $s;
}
# Link markdown local: sem esquema, sem '#' no início, sem '<', '*', '{'; âncora descartada.
sub md {
  my ($txt, $alvo, $dir, $cb) = @_;
  return $txt if $alvo eq '' || $alvo =~ /^[A-Za-z][A-Za-z0-9+.-]*:/ || $alvo =~ /^#/ || $alvo =~ /[<*{]/;
  (my $c = $alvo) =~ s/#.*//;
  my $r = $cb->($alvo, normaliza($dir eq '' ? $c : "$dir/$c"));
  return defined $r ? $r : $txt;
}
# percorre <linha> <pasta do arquivo> <cb> → linha (cb devolve substituto ou undef)
sub percorre {
  my ($s, $dir, $cb) = @_;
  my $o = '';
  while ($s =~ /\[[^\]]*\]\(([^()\s]*)(?:\s+"[^"]*")?\)/) {
    my ($pre, $txt, $alvo, $pos) = ($`, $&, $1, $');
    $o .= tokens($pre, $cb) . md($txt, $alvo, $dir, $cb);
    $s = $pos;
  }
  return $o . tokens($s, $cb);
}
# linhas_de_link <linhas> <arquivo> → índices (0-based) das linhas fora de frontmatter e fence;
# no MEMORY.md, também fora da seção Aprendizados, e nada em docs/audora/aprendizados.md
# (aprendizado cita caminho como exemplo histórico).
sub linhas_de_link {
  my ($l, $f) = @_; my @i; my ($fm, $fence, $apr) = (0, 0, 0);
  return () if $f eq 'docs/audora/aprendizados.md';
  for my $k (0 .. $#$l) {
    (my $s = $l->[$k]) =~ s/\r$//;
    if ($k == 0 && $s eq '---') { $fm = 1; next; }
    if ($fm) { $fm = 0 if $s eq '---'; next; }
    if ($s =~ /^\s*```/) { $fence = !$fence; next; }
    $apr = ($f eq 'MEMORY.md' && $s =~ /^## Aprendizados(\s|$)/) ? 1 : 0 if !$fence && $s =~ /^## /;
    push @i, $k unless $fence || $apr;
  }
  return @i;
}
# links <arquivo> → lista de [linha 1-based, alvo como escrito, caminho resolvido da raiz]
sub links {
  my ($f) = @_; my @r;
  my @l = split /\n/, ler($f), -1; my $dir = pasta_de($f);
  for my $k (linhas_de_link(\@l, $f)) {
    (my $s = $l[$k]) =~ s/\r$//;
    percorre($s, $dir, sub { push @r, [$k + 1, $_[0], $_[1]]; undef });
  }
  return @r;
}

my %CANDIDATO;   # arquivo → 1, para não listar link de arquivo que já sai no lote
sub classifica_links {
  $CANDIDATO{$_->[0]} = 1 for map { @{ $LOTE{$_} // [] } } @SECOES;
  $CANDIDATO{"docs/audora/memory/$_->[0].md"} = 1 for @{ $LOTE{'planned órfão'} // [] };
  for my $f ('MEMORY.md', grep { /\.md$/ } arquivos_docs()) {
    next if $CANDIDATO{$f};
    for my $k (links($f)) {
      next if -e $k->[2];
      if (existiu($k->[2])) { item('link quebrado', "$f:$k->[0]", "aponta $k->[1] inexistente"); }
      else { nunca("$f:$k->[0]", $k->[1]); }
    }
  }
}

# --- estado git: rastreados, sujos (índice ou árvore) e quem linka quem ---
my (%RASTREADO, %SUJO, %REF);
sub git_z {
  local $/ = "\0";
  open my $fh, '-|', 'git', '--no-optional-locks', @_ or die "git @_ falhou\n";
  my @r = <$fh>; close $fh; chomp @r; return @r;
}
sub carrega_git {
  %RASTREADO = map { $_ => 1 } git_z('ls-files', '-z');
  my @st = git_z('status', '--porcelain', '-z', '--untracked-files=no');
  while (@st) {
    my $e = shift @st; my $xy = substr($e, 0, 2);
    $SUJO{ substr($e, 3) } = 1;
    $SUJO{ shift @st } = 1 if $xy =~ /[RC]/ && @st;
  }
  # Referentes: só .md rastreado (link em .md não rastreado não é editado nem bloqueia).
  %REF = ();
  for my $f (sort { $a cmp $b } grep { /\.md$/ } keys %RASTREADO) {
    my %ja;
    for my $k (links($f)) { push @{ $REF{ $k->[2] } }, $f unless $ja{ $k->[2] }++ || $k->[2] eq $f; }
  }
}

# Caminhos tocados por item: [arquivos do próprio item], [referentes].
sub tocados {
  my ($sec, $alvo) = @_;
  if ($sec eq 'planned órfão') {
    my $no = "docs/audora/memory/$alvo.md";
    return (['MEMORY.md'], []) unless -e $no;
    return (['MEMORY.md', $no], [ @{ $REF{$no} // [] } ]);
  }
  if ($sec eq 'link quebrado') { (my $f = $alvo) =~ s/:\d+$//; return ([$f], []); }
  return ([$alvo], [ @{ $REF{$alvo} // [] } ]);
}

# Por que o item fica fora do lote (undef = pode entrar).
sub impedimento {
  my ($sec, $alvo) = @_;
  my ($proprio, $refs) = tocados($sec, $alvo);
  my $em = $sec eq 'planned órfão';
  for my $f (@$proprio) {
    return 'fora do git' unless $RASTREADO{$f};
    return 'mudança não commitada' . ($em ? " em $f" : '') if $SUJO{$f};
  }
  for my $f (@$refs) { return "mudança não commitada em $f" if $SUJO{$f}; }
  return undef;
}

# Filtro git final: candidato fora do git ou sujo vira "não tocado" (/11).
sub filtra_git {
  for my $s (@SECOES) {
    my @fica;
    for my $it (@{ $LOTE{$s} // [] }) {
      my $imp = impedimento($s, $it->[0]);
      if (defined $imp) { push @NAO_TOCADO, "- $it->[0] | não tocado: $imp"; } else { push @fica, $it; }
    }
    $LOTE{$s} = \@fica;
  }
}

sub total { my $n = 0; $n += scalar @{ $LOTE{$_} // [] } for @SECOES; return $n; }

sub relatorio {
  my $n = total();
  my @o = @AVISOS;
  push @o, 'cleanup: relatório — nada foi alterado' if $n;
  for my $s (@SECOES) {
    my @it = @{ $LOTE{$s} // [] } or next;
    push @o, "## $s", sort { $a cmp $b } map { "- $_->[0] | $_->[1]" } @it;
  }
  push @o, '## mantido', sort @MANTIDO if @MANTIDO;
  push @o, '## não tocado', sort @NAO_TOCADO if @NAO_TOCADO;
  push @o, '## nunca existiu', sort @NUNCA if @NUNCA;
  push @o, $n ? "total: $n item(ns) no lote" : 'cleanup: nada a limpar';
  print "$_\n" for @o;
}

sub varre { carrega_indice(); classifica_orfaos(); classifica_artefatos(); classifica_links(); carrega_git(); filtra_git(); }

# --- aplicar <lote>: o relatório aprovado (aparado pelo humano) vira 1 commit ---
use POSIX ();
use File::Temp ();
my $DATA = POSIX::strftime('%Y-%m-%d', localtime);
sub nota { "`$_[0]` removido em $DATA pela cleanup — recuperável no git" }
sub nota_quebrado { "`$_[0]` já não existia em $DATA (link limpo pela cleanup) — recuperável no git" }

# Itens das 7 seções acionáveis; cabeçalho, total:, aviso:, mantido e não tocado são ignorados.
sub le_lote {
  my ($arq) = @_; my (@it, $sec); my %acion = map { $_ => 1 } @SECOES;
  for (split /\n/, ler($arq)) {
    s/\r$//;
    if (/^## (.+?)\s*$/) { $sec = $1; next; }
    next unless defined $sec && $acion{$sec} && /^- (.+?) \| (.*)$/;
    push @it, { sec => $sec, alvo => $1, motivo => $2, linha => $_ };
  }
  return @it;
}

# troca_links <arquivo> <cb(alvo como escrito, caminho)> <nota(caminho)> [linha] → nº de trocas; preserva CRLF.
sub troca_links {
  my ($f, $quer, $nota, $so_linha) = @_;
  my @l = split /(?<=\n)/, ler($f);
  my @sem = map { s/\r?\n$//r } @l; my $dir = pasta_de($f); my $n = 0;
  for my $k (linhas_de_link(\@sem, $f)) {
    next if defined $so_linha && $k + 1 != $so_linha;
    my $fim = $l[$k] =~ /(\r?\n)$/ ? $1 : '';
    $l[$k] = percorre($sem[$k], $dir, sub { $quer->(@_) ? do { $n++; $nota->($_[1]) } : undef }) . $fim;
  }
  if ($n) { open my $fh, '>:raw', $f or die "não consegui escrever $f\n"; print $fh @l; close $fh or die "não consegui escrever $f\n"; }
  return $n;
}

sub git_ok { system('git', @_) == 0 or die "git $_[0] falhou\n"; }

my (@TOCADO, %TOCADO);
my %SAI;   # arquivo apagado pelo lote: não recebe troca de link (o git rm dele recusaria arquivo modificado)
sub toca { for (@_) { push @TOCADO, $_ unless $TOCADO{$_}++; } }

# Arquivo do lote: troca os links que apontam para ele e o remove.
sub apaga_arquivo {
  my ($alvo) = @_;
  for my $r (grep { !$SAI{$_} } @{ $REF{$alvo} // [] }) { toca($r); troca_links($r, sub { $_[1] eq $alvo }, \&nota); }
  toca($alvo); git_ok('rm', '-q', '--', $alvo);
}

my @IDS_APAGAR;   # linhas do índice apagadas no fim (não desloca a linha de link quebrado no MEMORY.md)
sub aplica_item {
  my ($it) = @_;
  if ($it->{sec} eq 'planned órfão') {
    my $no = "docs/audora/memory/$it->{alvo}.md";
    toca('MEMORY.md'); push @IDS_APAGAR, $it->{alvo};
    apaga_arquivo($no) if -e $no;
  } elsif ($it->{sec} eq 'link quebrado') {
    my ($f, $ln) = $it->{alvo} =~ /^(.*):(\d+)$/;
    my ($raw) = $it->{motivo} =~ /^aponta (.+) inexistente$/;
    die "link não encontrado na linha\n" unless defined $f && defined $raw;
    return if $SAI{$f};   # o arquivo sai no mesmo lote: nada a trocar
    toca($f);
    troca_links($f, sub { $_[0] eq $raw && !-e $_[1] }, \&nota_quebrado, $ln) or die "link não encontrado na linha\n";
  } else {
    apaga_arquivo($it->{alvo});
  }
}

# Exceção registrada à decisão viva grafo-v2: o script só APAGA a linha planned aprovada.
sub apaga_linhas_indice {
  my %ap = map { $_ => 1 } @_; my ($dentro, @o) = (0);
  for my $l (split /(?<=\n)/, ler('MEMORY.md')) {
    (my $s = $l) =~ s/\r?\n$//;
    $dentro = ($s =~ /^## Índice de nós/) ? 1 : 0 if $s =~ /^## /;
    next if $dentro && $s =~ /^- *([^ |]+) *\| *planned *\|/ && $ap{$1};
    push @o, $l;
  }
  open my $fh, '>:raw', 'MEMORY.md' or die "não consegui escrever MEMORY.md\n";
  print $fh @o; close $fh or die "não consegui escrever MEMORY.md\n";
}

# Roda hooks/memory-validate (mesmo contrato do harness: JSON no stdin, exit 2 + stderr).
sub valida_memory {
  require Cwd;
  my $mem = Cwd::getcwd() . '/MEMORY.md'; $mem =~ s/([\\"])/\\$1/g;
  my $in = File::Temp->new(); print $in qq({"tool_name":"Edit","tool_input":{"file_path":"$mem"}}); close $in;
  my $err = File::Temp->new(); close $err;
  my $rc = system('bash', '-c', 'bash "$1" < "$2" > /dev/null 2> "$3"', 'cleanup',
                  "$ENV{CLEANUP_DIR}/memory-validate", $in->filename, $err->filename);
  return if $rc == 0;
  my @e = map { s/\r$//r } split /\n/, ler($err->filename);
  my ($l) = grep { /^- / } @e; $l //= $e[0] // "memory-validate saiu $rc";
  die 'MEMORY inválido: ' . ($l =~ s/^- //r) . "\n";
}

# Lista de um tipo no corpo do commit: "<tipo>: a, b, c" quebrada em linhas de até
# $LARGURA bytes (body-max-line-length do commitlint), continuação recuada com 2 espaços;
# item que não cabe sozinho numa linha sai da lista e vira contagem (cleanup-commit-curto).
my $LARGURA = 100;
sub lista_tipo {
  my ($s, @a) = @_;
  my @cabe = grep { length($_) + 3 <= $LARGURA } @a;
  my $longos = @a - @cabe;
  my ($l, @linhas) = ("$s:");
  for my $i (0 .. $#cabe) {
    my $t = $cabe[$i] . ($i < $#cabe ? ',' : '');
    if (length("$l $t") <= $LARGURA) { $l .= " $t"; next; }
    push @linhas, $l;
    $l = "  $t";
  }
  push @linhas, $l;
  push @linhas, "  (+$longos caminho(s) longo(s) — ver git show --stat)" if $longos;
  return join("\n", @linhas) . "\n";
}

sub commita {
  my (@it) = @_;
  my $msg = 'chore(cleanup): remove ' . scalar(@it) . " sobra(s) do processo\n\n";
  for my $s (@SECOES) {
    my @a = map { $_->{alvo} } grep { $_->{sec} eq $s } @it or next;
    $msg .= lista_tipo($s, @a);
  }
  my $tmp = File::Temp->new(); print $tmp $msg; close $tmp;
  system('git', 'commit', '-q', '-F', $tmp->filename, '--', @TOCADO) == 0 or die "commit recusado\n";
  my ($h) = git_z('rev-parse', '--short=7', 'HEAD');
  $h =~ s/\s+$//;
  return $h;
}

# Pré-checagem, antes de tocar qualquer arquivo (undef = item pode ser aplicado).
sub pre_checa {
  my ($it) = @_; my ($s, $a) = ($it->{sec}, $it->{alvo});
  if ($s eq 'planned órfão') {
    return 'alvo não existe mais' unless grep { $_->{id} eq $a && $_->{estado} eq 'planned' } @INDICE;
  } else {
    my $link = $s eq 'link quebrado';
    my $f = $link ? ($a =~ s/:\d+$//r) : $a;
    return 'fora de docs/audora/' unless $f =~ m{^docs/audora/} || ($link && $f eq 'MEMORY.md');
    return 'arquivo lido pelo framework nunca é removido' if !$link && protegido($f);
    return 'alvo não existe mais' unless -e $f;
    if ($link) {   # link quebrado só se o alvo existiu (lote montado à mão pode trazer nunca versionado)
      my ($ln) = $a =~ /:(\d+)$/;
      my ($raw) = $it->{motivo} =~ /^aponta (.+) inexistente$/;
      for my $k (grep { defined $ln && defined $raw && $_->[0] == $ln && $_->[1] eq $raw } links($f)) {
        return "link para caminho nunca versionado: $k->[2]" unless -e $k->[2] || existiu($k->[2]);
      }
    }
  }
  my ($proprio, $refs) = tocados($s, $a);
  for my $f (@$proprio, @$refs) {
    return "fora do git: $f" unless $RASTREADO{$f};
    return "mudança não commitada em $f" if $SUJO{$f};
  }
  return undef;
}

# Desfaz: índice e árvore dos caminhos tocados voltam ao HEAD (todos eram rastreados e limpos).
sub desfaz {
  return unless @TOCADO;
  system('git', 'reset', '-q', '--', @TOCADO);
  my %head = map { $_ => 1 } git_z('ls-tree', '-r', '-z', '--name-only', 'HEAD', '--', @TOCADO);
  my @h = grep { $head{$_} } @TOCADO;
  system('git', 'checkout', '-q', 'HEAD', '--', @h) if @h;
}
sub falha {
  my ($onde, $motivo) = @_; chomp $motivo;
  desfaz();
  sai(1, "cleanup: falhou em: $onde — $motivo", 'cleanup: lote desfeito, nada commitado');
}

sub aplicar {
  my ($arq) = @_;
  sai(1, $USO) if !defined $arq || $arq eq '';
  sai(1, "cleanup: lote $arq não encontrado") unless -f $arq;
  my @it = le_lote($arq);
  sai(0, 'cleanup: lote vazio — nada aplicado') unless @it;
  carrega_indice(); carrega_git();
  for my $i (@it) { my $m = pre_checa($i); falha($i->{linha}, $m) if defined $m; }
  for my $i (grep { $_->{sec} ne 'link quebrado' } @it) {
    $SAI{ $i->{sec} eq 'planned órfão' ? "docs/audora/memory/$i->{alvo}.md" : $i->{alvo} } = 1;
  }
  my $onde = '';
  my $h = eval {
    for my $i (@it) { $onde = $i->{linha}; aplica_item($i); }
    $onde = 'MEMORY.md';
    apaga_linhas_indice(@IDS_APAGAR) if @IDS_APAGAR;
    valida_memory() if grep { $_ eq 'MEMORY.md' || m{^docs/audora/memory/} } @TOCADO;
    $onde = 'commit';
    commita(@it);
  };
  falha($onde, $@ || 'erro desconhecido') unless defined $h;
  sai(0, "cleanup: commit $h — " . scalar(@it) . ' item(ns) removido(s)');
}

if ($sub eq 'aplicar') { aplicar(shift @ARGV); }
if ($sub eq 'contar') { varre(); print total(), "\n"; exit 0; }
if ($sub eq 'varrer') { varre(); relatorio(); exit 0; }
sai(1, $USO);
