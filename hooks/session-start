#!/usr/bin/env bash
# Hook SessionStart do plugin audora-commander.
# Injeta ponteiro CURTO para a porta de entrada — nunca o framework inteiro
# (princípio do próprio framework: contexto é o gargalo).

set -euo pipefail

contexto="Framework audora-commander ativo. Ao receber demanda de software (criar, alterar, corrigir), invoque a skill \`audora-commander:audora-commander\` ANTES de agir. Memória do produto: MEMORY.md (skill memory; Graphify indexa o código). Fluxos de fase: memory, scope, plan, execute, e2e, validate; bug ou comportamento inesperado: debug; isolamento em git worktree, só a pedido explícito: worktree. Instrução direta do usuário vale mais que o framework."

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$contexto"

exit 0
