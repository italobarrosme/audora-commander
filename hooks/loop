#!/usr/bin/env bash
# Motor de loop (audora-commander) — roda o plano de uma demanda elegível
# volta a volta: claude -p novo por volta, gate fora do agente, commit no
# verde. Script auxiliar (chamado via Bash), não é hook do Claude.
# Uso: loop <id> [--voltas-tarefa N] [--voltas-rodada N] [--custo-usd X]
#              [--model M] [--confirmo-sem-sandbox]
# Env: LOOP_ROOT (raiz do projeto-alvo), LOOP_CLAUDE_CMD (default: claude).
set -uo pipefail
cd "${LOOP_ROOT:-$(dirname "$0")/..}" || exit 1

id="${1:-}"
[ -n "$id" ] || { echo "LOOP: uso: loop <id> [opções]"; exit 1; }
shift
vt=""; vr=""; cu=""; model=""; semsandbox_ok=0
while [ $# -gt 0 ]; do
  case "$1" in
    --voltas-tarefa) vt="$2"; shift 2 ;;
    --voltas-rodada) vr="$2"; shift 2 ;;
    --custo-usd) cu="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --confirmo-sem-sandbox) semsandbox_ok=1; shift ;;
    *) echo "LOOP: argumento desconhecido: $1"; exit 1 ;;
  esac
done

no="docs/audora/memory/$id.md"
plano="docs/audora/planos/plano-$id.md"
faltas=()

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || faltas+=("repo git (o motor só roda dentro de git)")
[ -f "$no" ] || faltas+=("nó $no")
[ -f "$plano" ] || faltas+=("plano $plano")
grep -q '^autopilot: elegivel' "$no" 2>/dev/null || \
  faltas+=("nó com 'autopilot: elegivel' — elegibilidade é pré-condição")

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
case "$branch" in
  main|master) faltas+=("branch própria da demanda (está em '$branch')") ;;
esac

const_bullet() { grep -m1 "^- \*\*$1\*\*:" MEMORY.md 2>/dev/null | sed "s/^- \*\*$1\*\*: *//"; }
gate_raw="$(const_bullet gate)"
if [ -z "$gate_raw" ] || [ "$gate_raw" = recusado ]; then
  faltas+=("bullet 'gate:' na Constituição — sem gate, veredito é do agente")
fi
sandbox="$(const_bullet sandbox)"
[ -n "$sandbox" ] || faltas+=("bullet 'sandbox:' na Constituição (docker | vm | nenhum)")

lp_bullet="$(const_bullet loop)"
get_teto() { printf '%s' "$lp_bullet" | grep -o "$1=[0-9.]*" | cut -d= -f2; }
[ -n "$vt" ] || vt="$(get_teto voltas-tarefa)"
[ -n "$vr" ] || vr="$(get_teto voltas-rodada)"
[ -n "$cu" ] || cu="$(get_teto custo-usd)"
{ [ -n "$vt" ] && [ -n "$vr" ] && [ -n "$cu" ]; } || \
  faltas+=("tetos — parâmetros (--voltas-tarefa/--voltas-rodada/--custo-usd) ou bullet 'loop:' na Constituição")

if [ "${sandbox:-}" = nenhum ] && [ "$semsandbox_ok" -ne 1 ]; then
  faltas+=("confirmação explícita para sandbox 'nenhum' (--confirmo-sem-sandbox)")
fi

if [ "${#faltas[@]}" -gt 0 ]; then
  echo "LOOP: rodada recusada — falta:"
  printf '  - %s\n' "${faltas[@]}"
  exit 1
fi

if [ "$sandbox" = nenhum ]; then
  echo "LOOP: AVISO — rodando SEM sandbox, confirmado pelo humano nesta rodada"
fi
echo "LOOP: pré-condições OK (gate: $gate_raw | sandbox: $sandbox | tetos: tarefa=$vt rodada=$vr custo-usd=$cu)"

# --- rodada ---
gate_cmd="$(printf '%s' "$gate_raw" | sed 's/ — .*//' | tr -d '\140')"
gate_cmd="${gate_cmd//<id-da-demanda>/$id}"
CLAUDE="${LOOP_CLAUDE_CMD:-claude}"
loopdir="docs/audora/planos/loop/$id"
mkdir -p "$loopdir"
tpl="$(cd "$(dirname "$0")/../templates" 2>/dev/null && pwd)/loop-prompt-template.md"

rodada=1
while ls "$loopdir"/rodada$rodada-* >/dev/null 2>&1; do rodada=$((rodada+1)); done

tarefa_secao() { awk -v n="$1" '$0 ~ ("^## Tarefa " n ":") {f=1; print; next} /^## /{f=0} f' "$plano"; }
tarefas_todas() { grep -o '^## Tarefa [0-9]*' "$plano" | grep -o '[0-9]*'; }
abertas() {
  local n c=0
  for n in $(tarefas_todas); do
    tarefa_secao "$n" | grep -q 'concluida-pelo-motor' || c=$((c+1))
  done
  echo "$c"
}
proxima_tarefa() {
  local n d ok deps
  for n in $(tarefas_todas); do
    tarefa_secao "$n" | grep -q 'concluida-pelo-motor' && continue
    deps="$(tarefa_secao "$n" | grep -m1 'depende-de' | grep -o 'Tarefa [0-9]*' | grep -o '[0-9]*' || true)"
    ok=1
    for d in $deps; do
      tarefa_secao "$d" | grep -q 'concluida-pelo-motor' || ok=0
    done
    [ "$ok" = 1 ] && { echo "$n"; return 0; }
  done
  return 0
}

volta=0; verdes=0; vermelhos=0; custo_acum=0; consec=0; ult=""
parada=""; virou_blocked=0
notas="$loopdir/rodada$rodada-notas.md"

while :; do
  if grep -q 'PRECISA-CLARIFICAR' "$no" "$plano" 2>/dev/null; then
    parada="marcador [PRECISA-CLARIFICAR] aberto — aguardando humano"; break
  fi
  [ "$volta" -ge "$vr" ] && { parada="teto de voltas da rodada ($vr)"; break; }
  awk "BEGIN{exit !($custo_acum >= $cu)}" && { parada="teto de custo (US\$ $cu, gasto $custo_acum)"; break; }
  [ "$consec" -ge "$vt" ] && { parada="tarefa $ult vermelha $vt vezes seguidas"; virou_blocked=1; break; }
  n="$(proxima_tarefa)"
  if [ -z "$n" ]; then
    if [ "$(abertas)" -eq 0 ]; then parada="DONE"; else parada="dependência insatisfeita (plano retomável)"; fi
    break
  fi
  volta=$((volta+1)); ult="$n"
  pfile="$loopdir/rodada$rodada-volta$volta-prompt.txt"
  tarefa_secao "$n" > "$loopdir/.tarefa"
  awk '/^```text$/{f=1;next} /^```$/{f=0} f' "$tpl" | sed "s/{{ID}}/$id/g" | \
    awk -v no="$no" -v pl="$plano" -v ta="$loopdir/.tarefa" '
      /^\{\{NO\}\}$/     { while ((getline l < no) > 0) print l; close(no); next }
      /^\{\{PLANO\}\}$/  { while ((getline l < pl) > 0) print l; close(pl); next }
      /^\{\{TAREFA\}\}$/ { while ((getline l < ta) > 0) print l; close(ta); next }
      { print }' > "$pfile"
  rm -f "$loopdir/.tarefa"
  restante="$(awk "BEGIN{print $cu - $custo_acum}")"
  echo "LOOP: rodada $rodada volta $volta — tarefa $n (orçamento restante US\$ $restante)"
  saida="$("$CLAUDE" -p "$(cat "$pfile")" --output-format json --max-budget-usd "$restante" ${model:+--model "$model"} 2>&1)" || true
  custo_volta="$(printf '%s' "$saida" | grep -o '"total_cost_usd":[0-9.]*' | head -1 | cut -d: -f2)"
  custo_acum="$(awk "BEGIN{print $custo_acum + ${custo_volta:-0}}")"
  glog="$loopdir/rodada$rodada-volta$volta-gate.log"
  if bash -c "$gate_cmd" > "$glog" 2>&1; then
    verdes=$((verdes+1)); consec=0
    sed -i "s/^## Tarefa $n:.*/&\n\n- [x] concluida-pelo-motor (rodada $rodada, volta $volta)/" "$plano"
    ends="$(tarefa_secao "$n" | grep -o "$id\/[0-9]*" | sort -u | tr '\n' ' ' | sed 's/ $//')"
    git add -A -- . ":(exclude)$loopdir" >/dev/null 2>&1
    git commit -qm "loop($id): volta $volta verde — tarefa $n [$ends]"
    echo "LOOP: volta $volta VERDE — tarefa $n commitada e marcada"
  else
    vermelhos=$((vermelhos+1)); consec=$((consec+1))
    git diff HEAD > "$loopdir/rodada$rodada-volta$volta.patch" 2>/dev/null
    git checkout -q -- . 2>/dev/null
    git clean -qfd -e docs/audora/planos/loop >/dev/null 2>&1
    { printf -- '- rodada %s volta %s (tarefa %s) VERMELHA — gate:\n' "$rodada" "$volta" "$n"
      sed 's/^/  /' "$glog"; } >> "$notas"
    echo "LOOP: volta $volta VERMELHA — tarefa $n (patch guardado, árvore descartada)"
  fi
done

tempo="$SECONDS"
{ grep -q '^## Métricas de rodada (loop)' "$plano" || printf '\n## Métricas de rodada (loop)\n'
  printf -- '\n- rodada %s: voltas=%s verdes=%s vermelhos=%s custo-usd=%s tempo=%ss parada=%s\n' \
    "$rodada" "$volta" "$verdes" "$vermelhos" "$custo_acum" "$tempo" "$parada"
  if [ -s "$notas" ]; then printf '\n### Notas de sessão da rodada %s\n\n' "$rodada"; cat "$notas"; fi
} >> "$plano"

if [ "$virou_blocked" -eq 1 ]; then
  sed -i 's/^estado: in-progress/estado: blocked/' "$no"
  sed -i "s/^- $id | in-progress |/- $id | blocked |/" MEMORY.md
fi

echo "LOOP: rodada $rodada encerrada — $parada (voltas=$volta verdes=$verdes vermelhos=$vermelhos custo-usd=$custo_acum tempo=${tempo}s)"
if [ "$parada" = DONE ]; then
  echo "DONE"
  echo "LOOP: próxima ação — preparação de evidência da validate"
  exit 0
fi
[ "$virou_blocked" -eq 1 ] && echo "LOOP: nó '$id' virou blocked — decisão humana: replanejar, destravar ou abandonar"
exit 1
